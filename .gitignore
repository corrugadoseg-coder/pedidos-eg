# Este repo es PUBLICO: guarda solo la app (index.html y 365/).
# Datos, planillas, documentos y backups quedan afuera.

# Documentos y planillas de Office
*.docx
*.doc
*.xlsx
*.xls
*.csv
*.pdf

# Datos exportados o importados (los datos viven en SharePoint, nunca aca)
*.json

# Archivos temporales / de bloqueo de Office
~$*
*.tmp

# Basura del sistema operativo
Thumbs.db
desktop.ini
.DS_Store

# Copias de seguridad de editores
*.bak
*~

# Backups del backend (Apps Script): SOLO local, no al repo publico
apps-script/

# Configuracion local de Claude Code
.claude/

# Configuracion y datos privados generados localmente (van a SharePoint, nunca al repo)
privado/
